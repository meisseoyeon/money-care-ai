# FastAPI runs on the host; PostgreSQL is exposed on port 5433.
DATABASE_URL=postgresql+psycopg://moneycare:change_me_local@127.0.0.1:5433/moneycare
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Server-side AI credentials (configure when implementing AI services).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Must be at least 32 bytes. Never commit an actual key.
DEMO_JWT_SECRET=
# Existing DEMO_SESSION_TTL_SECONDS is accepted as a fallback.
AUTH_SESSION_TTL_SECONDS=86400
