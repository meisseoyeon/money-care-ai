# EC2에서: cp .env.example .env 후 값 채우기. 이 .env는 Git에 올리지 않음.

# DB 계정. 비밀번호는 영문, 숫자만 (URL에 들어가서 특수문자가 있으면 깨짐)
POSTGRES_USER=moneycare
POSTGRES_PASSWORD=change_me_long_random
POSTGRES_DB=moneycare

# 접속 주소. 도메인이 없으면 http://서버IP, 도메인이 있으면 https://도메인
PUBLIC_ORIGIN=http://0.0.0.0
# 도메인이 있으면 도메인만 (예: moneycare.duckdns.org). 비워 두면 :80 (http)
SITE_ADDRESS=

# 서버 전용 비밀값
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# 생성: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
DEMO_JWT_SECRET=
AUTH_SESSION_TTL_SECONDS=86400
